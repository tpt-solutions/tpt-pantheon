{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "telos",
  "scopeName": "source.telos",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.telos",
          "match": "//.*$"
        },
        {
          "name": "comment.block.telos",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.telos",
          "match": "(@)(boundary|state|eject)(?:\\(([^)]+)\\))?",
          "captures": {
            "0": { "name": "storage.modifier.attribute.telos" },
            "1": { "name": "punctuation.definition.attribute.telos" },
            "2": { "name": "entity.name.tag.attribute.telos" },
            "3": { "name": "string.unquoted.attribute-args.telos" }
          }
        },
        {
          "name": "storage.modifier.attribute.telos",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*(?:\\([^)]*\\))?"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.telos",
          "match": "\\b(if|else|match|return|forall)\\b"
        },
        {
          "name": "keyword.declaration.telos",
          "match": "\\b(module|invariant|func|struct|enum|let)\\b"
        },
        {
          "name": "keyword.other.telos",
          "match": "\\b(requires|ensures|mutate|state|old|mut)\\b"
        },
        {
          "name": "constant.language.telos",
          "match": "\\b(Ok|Err)\\b"
        },
        {
          "name": "support.function.builtin.telos",
          "match": "\\b(sum|min|max|count)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.telos",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.telos",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.telos",
          "match": "&&|\\|\\||=>"
        },
        {
          "name": "keyword.operator.arithmetic.telos",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.telos",
          "match": "\\+=|-=|="
        },
        {
          "name": "keyword.operator.range.telos",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.try.telos",
          "match": "\\?"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.telos",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.telos",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
